# Segredos. O `npm run instalar` cria o .env com o que você responder. Nunca suba o .env para o GitHub.

# Chave da IA escolhida em ia.provedor no config.yaml (Anthropic, OpenAI ou OpenRouter).
IA_CHAVE=

# Vazio: banco SQLite neste computador. Preenchido: Postgres/Supabase compartilhado entre computadores.
DATABASE_URL=

# Só se caixa.provedor for zernio.
ZERNIO_API_KEY=

# Só se caixa.provedor for meta: token da conta do Instagram gerado no painel do seu app da Meta.
META_ACCESS_TOKEN=

# Opcional: caminho do Chrome, se ele não estiver no lugar padrão.
CHROME_PATH=
